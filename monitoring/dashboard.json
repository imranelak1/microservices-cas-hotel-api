{
  "uid": "hotel-api",
  "title": "Hôtel — Comparaison des API",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Débit HTTP",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(protocol)(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{protocol}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latence p95 Java",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(.95,sum by(protocol,le)(rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{protocol}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latence p95 GraphQL",
